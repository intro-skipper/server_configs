RewriteEngine On

# Jellyfin 10.x → its own branch, 12.x → the shared "12" branch.
RewriteCond %{REQUEST_URI} /manifest\.json$
RewriteCond %{HTTP_USER_AGENT} ^Jellyfin-Server/(10\.[0-9]+|12)\.
RewriteRule ^ https://raw.githubusercontent.com/intro-skipper/manifest/refs/heads/main/%1/manifest.json [R=302,L]

# Everything else (wrong path, non-Jellyfin UA, unknown Jellyfin version) → GitHub
RewriteRule ^ https://github.com/intro-skipper/ [R=302,L]
