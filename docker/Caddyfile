*.intro-skipper.org intro-skipper.org {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	log {
		output discard
	}

	vars {
		commit_hash "e0c7d065e10aa4882308bf55462f9bb6733f17bc"
	}

	@discord host discord.intro-skipper.org
	redir @discord https://discord.gg/AYZ7RJ3BuA 308

	# GitHub webhook receivers: only the secret path is reachable.
	@github host fsn1.intro-skipper.org ams.intro-skipper.org fra.intro-skipper.org
	handle @github {
		handle /{$GITHUB_HOOK} {
			rewrite /hook
			reverse_proxy 127.0.0.1:8080
		}
		handle {
			abort
		}
	}

	# Jellyfin 10.x → its own branch, 12.x → the shared "12" branch.
	# Path matching is case-insensitive but the CDN is not, so emit fixed file names.
	@manifest {
		path /manifest.json
		header_regexp VER User-Agent ^Jellyfin-Server/(10\.\d+|12)\.
	}
	redir @manifest https://cdn.jsdelivr.net/gh/intro-skipper/manifest@{vars.commit_hash}/{re.VER.1}/manifest.json 302

	@prerelease {
		path /manifest-prerelease.json
		header_regexp VER User-Agent ^Jellyfin-Server/(10\.\d+|12)\.
	}
	redir @prerelease https://cdn.jsdelivr.net/gh/intro-skipper/manifest@{vars.commit_hash}/{re.VER.1}/manifest-prerelease.json 302

	# Everything else (wrong path, non-Jellyfin UA, unknown Jellyfin version) → GitHub
	@fallback not host fsn1.intro-skipper.org ams.intro-skipper.org fra.intro-skipper.org
	redir @fallback https://github.com/intro-skipper/ 308
}
